{
  "compilerOptions": {
    "lib": [
      "deno.ns",
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "strict": true
  },
  "imports": {
    "fx": "./fx/fx.ts",
    "fx/": "./fx/",
    "path": "node:path",
    "fs": "node:fs",
    "fs/promises": "node:fs/promises",
    "chokidar": "npm:chokidar@^4.0.0",
    "msgpack-lite": "npm:msgpack-lite@0.1.26"
  },
  "tasks": {
    "start": "deno run --allow-all src/server.ts",
    "dev": "deno run --allow-all --watch src/server.ts"
  }
}